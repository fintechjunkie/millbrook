# Normalize line endings for text, so specs stay byte-stable across machines.
# Byte-stability matters here: the prose in patch-notes/specs/ is verbatim
# source and is diffed against the original manuscripts.
* text=auto eol=lf

*.md   text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# Binary. Marked explicitly so git never attempts a diff or an EOL rewrite.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.pdf  binary
*.woff binary
*.woff2 binary
